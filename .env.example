# ── Database (required) ──
DATABASE_URL=postgresql://username:password@localhost:5432/topical

# ── Sessions ──
# How long a session survives without being used. Sessions are server-side
# rows, so signing out revokes one immediately.
SESSION_TTL_DAYS=14

# ── Server ──
# PORT is what Vite's dev proxy points at; change both together.
PORT=3000
HOST=0.0.0.0
# "production" marks session cookies Secure, which requires HTTPS.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Where uploaded images are written. Defaults to ./uploads.
# UPLOADS_DIR=/var/lib/topical/uploads

# ── AI ──
# There is no key here on purpose: each user adds their own provider key in
# the web UI, under Profile → AI Providers. It is held in their browser and
# sent as a header on the request that needs it — never stored server-side.
